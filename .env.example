# Google Maps Distance Matrix API (server-side only)
GOOGLE_MAPS_API_KEY=
# Vercel Cron and manual update authorization
CRON_SECRET=
# Maximum Google Maps requests made by one cron/manual run
MAX_GOOGLE_MAPS_REQUESTS_PER_RUN=100
# 同時にGoogle Mapsへ問い合わせる数（1〜8、既定5）
GOOGLE_MAPS_CONCURRENCY=5
# Vercelタイムアウト前に安全終了する時間（ミリ秒）
GOOGLE_MAPS_MAX_RUNTIME_MS=45000
GOOGLE_MAPS_RETRY_MINUTES=60
# 予定シフトを概算対象にする未来期間（月）。既定12か月
GOOGLE_MAPS_DISTANCE_FUTURE_MONTHS=12

# Google Drive PDF保存（サーバー側のみ）
